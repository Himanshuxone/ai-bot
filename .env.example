# Copy to .env and fill in. NEVER commit .env.            [RULE: SEC-SECRETS]
FINRAG_ENVIRONMENT=development            # production = fail-closed checks
FINRAG_DATA_DIR=./data

# Generate with: python -m finrag.cli keygen   (store in a secret manager in prod)
FINRAG_MASTER_KEY=

# offline = local extractive answers, nothing leaves the host (default)
# anthropic = Claude; only pseudonymised top-k excerpts are sent
FINRAG_LLM_PROVIDER=offline
FINRAG_ANTHROPIC_MODEL=claude-opus-5-5
FINRAG_ANTHROPIC_EFFORT=medium
# ANTHROPIC_API_KEY is read by the Anthropic SDK directly:
# ANTHROPIC_API_KEY=

# JSON file with hashed API keys (see keys.example.json)
FINRAG_API_KEYS_FILE=./keys.json

FINRAG_DEFAULT_RETENTION_DAYS=90
FINRAG_AUDIT_RETENTION_DAYS=365
FINRAG_RATE_LIMIT_PER_MINUTE=30
FINRAG_REVIEW_CONFIDENCE_THRESHOLD=0.55
