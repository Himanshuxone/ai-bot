<mxfile host="app.diagrams.net" agent="FinRAG docs">
<diagram id="finrag-rag-flow" name="RAG flow">
<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2260" pageHeight="1600" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="lane_i" value="INGESTION   POST /v1/documents" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;opacity=35;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=15;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="560" height="1010" as="geometry"/></mxCell>
<mxCell id="lane_q" value="QUERY   POST /v1/query" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;opacity=35;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=15;dashed=1;" vertex="1" parent="1"><mxGeometry x="1010" y="250" width="700" height="1180" as="geometry"/></mxCell>
<mxCell id="lane_s" value="STORES   (per tenant, encrypted at rest)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;opacity=35;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=15;dashed=1;" vertex="1" parent="1"><mxGeometry x="640" y="250" width="330" height="1010" as="geometry"/></mxCell>
<mxCell id="title" value="&lt;b&gt;FinRAG: end-to-end RAG flow&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Ingestion (left) and query (right) around the encrypted stores. Every box lists its function and file; each control carries a [RULE: ID] tag in code.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2180" height="60" as="geometry"/></mxCell>
<mxCell id="user" value="&lt;b&gt;User&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Analyst / viewer / DPO in the web UI (finrag/web/js/views/*.js) or an API client&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="560" y="110" width="480" height="60" as="geometry"/></mxCell>
<mxCell id="api" value="&lt;b&gt;FastAPI gateway&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;finrag/api.py · get_principal(): API key or demo token → Principal (role, tenant) · security headers + CSP · RBAC · demo workspace (finrag/demo.py)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="560" y="180" width="1100" height="60" as="geometry"/></mxCell>
<mxCell id="i1" value="&lt;b&gt;1  Receive upload&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;upload_document() → FinRAGPipeline.ingest()&lt;br/&gt;finrag/api.py · finrag/pipeline.py&lt;br/&gt;file + lawful basis, purpose, retention&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="70" y="290" width="500" height="74" as="geometry"/></mxCell>
<mxCell id="i2" value="&lt;b&gt;2  Validate and load&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;load_document() · finrag/ingestion/loaders.py&lt;br/&gt;extension allow-list, size cap, zip-bomb, macro, fake-PDF checks&lt;br/&gt;→ Sections (PDF / XLSX / CSV / TXT / MD)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="70" y="390" width="500" height="74" as="geometry"/></mxCell>
<mxCell id="i3" value="&lt;b&gt;3  De-duplicate&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;TenantStore.find_by_hash() · finrag/retrieval/store.py&lt;br/&gt;SHA-256 of the file; same content is not stored twice&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="70" y="490" width="500" height="74" as="geometry"/></mxCell>
<mxCell id="i4" value="&lt;b&gt;4  GDPR gate&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;validate_processing(), retention_deadline() · finrag/governance/gdpr.py&lt;br/&gt;lawful basis, purpose, Art. 9 condition for special-category data&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="70" y="590" width="500" height="74" as="geometry"/></mxCell>
<mxCell id="i5" value="&lt;b&gt;5  Pseudonymise PII&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;PIIDetector + Pseudonymiser.pseudonymise() · finrag/security/pii.py&lt;br/&gt;IBAN, e-mail, card, ID → keyed tokens; originals go to the vault&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="70" y="690" width="500" height="74" as="geometry"/></mxCell>
<mxCell id="i6" value="&lt;b&gt;6  Chunk&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;chunk_sections() · finrag/ingestion/chunker.py&lt;br/&gt;text with overlap; table rows keep column names, header repeated&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="70" y="790" width="500" height="74" as="geometry"/></mxCell>
<mxCell id="i7" value="&lt;b&gt;7  Screen chunks&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;screen_context() · finrag/security/guardrails.py&lt;br/&gt;instruction-like text is quarantined (stored, never retrieved)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="70" y="890" width="500" height="74" as="geometry"/></mxCell>
<mxCell id="i8" value="&lt;b&gt;8  Index and store&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;TenantStore.add_document() · HybridIndex (BM25 + hashed TF-IDF)&lt;br/&gt;finrag/retrieval/store.py · finrag/retrieval/index.py&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="70" y="990" width="500" height="74" as="geometry"/></mxCell>
<mxCell id="i9" value="&lt;b&gt;9  Audit and report&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;AuditLog.record('ingest') · finrag/security/audit.py&lt;br/&gt;returns IngestReport (chunks, PII masked, quarantined)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="70" y="1090" width="500" height="74" as="geometry"/></mxCell>
<mxCell id="rej" value="&lt;b&gt;Upload rejected&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;HTTP 422 + audit entry&lt;br/&gt;(bad file, no lawful basis, missing Art. 9 condition)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="660" y="290" width="290" height="74" as="geometry"/></mxCell>
<mxCell id="s_vault" value="&lt;b&gt;PseudonymVault&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;token ↔ original values&lt;br/&gt;encrypted (Fernet / HKDF keys)&lt;br/&gt;finrag/security/pii.py, crypto.py&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="660" y="470" width="290" height="100" as="geometry"/></mxCell>
<mxCell id="s_store" value="&lt;b&gt;TenantStore&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;documents + pseudonymised chunks&lt;br/&gt;encrypted JSON, per-tenant folder&lt;br/&gt;finrag/retrieval/store.py&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="660" y="640" width="290" height="100" as="geometry"/></mxCell>
<mxCell id="s_index" value="&lt;b&gt;HybridIndex&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;BM25 + hashed TF-IDF vectors&lt;br/&gt;exact search, in memory, no vector database&lt;br/&gt;finrag/retrieval/index.py&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="660" y="810" width="290" height="100" as="geometry"/></mxCell>
<mxCell id="s_audit" value="&lt;b&gt;Audit log&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;append-only, hash-chained (HMAC)&lt;br/&gt;no raw PII · verify_audit()&lt;br/&gt;finrag/security/audit.py&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="660" y="980" width="290" height="100" as="geometry"/></mxCell>
<mxCell id="s_note" value="&lt;b&gt;Vercel demo&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;on Vercel the data folder is /tmp/finrag; samples are re-seeded per visitor workspace&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="660" y="1110" width="290" height="110" as="geometry"/></mxCell>
<mxCell id="q1" value="&lt;b&gt;1  Receive question&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;query() → FinRAGPipeline.ask() · finrag/api.py · finrag/pipeline.py&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1040" y="290" width="620" height="66" as="geometry"/></mxCell>
<mxCell id="q2" value="&lt;b&gt;2  Rate limit and RBAC&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;RateLimiter.allow(), Permission.QUERY · finrag/security/access.py&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1040" y="380" width="620" height="66" as="geometry"/></mxCell>
<mxCell id="q3" value="&lt;b&gt;3  Check the question&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;check_query() · finrag/security/guardrails.py&lt;br/&gt;length, prompt-injection, prohibited / high-risk uses, PII flag&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1040" y="470" width="620" height="66" as="geometry"/></mxCell>
<mxCell id="q4" value="&lt;b&gt;4  Pseudonymise the question&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Pseudonymiser.pseudonymise() · finrag/security/pii.py&lt;br/&gt;same tokens as in the documents, so matching still works&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1040" y="560" width="620" height="66" as="geometry"/></mxCell>
<mxCell id="q5" value="&lt;b&gt;5  Retrieve&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;TenantStore.search() → HybridIndex.search(top_k) · finrag/retrieval/&lt;br/&gt;hybrid BM25 + TF-IDF score, min_relevance cut-off&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1040" y="650" width="620" height="66" as="geometry"/></mxCell>
<mxCell id="q6" value="&lt;b&gt;6  Screen retrieved chunks&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;screen_context() · drop instruction-like chunks&lt;br/&gt;no usable chunks → 'no answer', LLM is skipped&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1040" y="740" width="620" height="66" as="geometry"/></mxCell>
<mxCell id="q7" value="&lt;b&gt;7  Build the prompt&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;build_user_message() · finrag/generation/prompts.py&lt;br/&gt;sources fenced as untrusted data, [S1]..[Sn] labels, canary in system prompt&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1040" y="830" width="620" height="66" as="geometry"/></mxCell>
<mxCell id="q8" value="&lt;b&gt;8  Generate the answer&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;build_generator() → AnthropicLLM | OfflineLLM · finrag/generation/llm.py&lt;br/&gt;Claude only if enabled (masked text, no tools); default offline extractive&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1040" y="920" width="620" height="66" as="geometry"/></mxCell>
<mxCell id="q9" value="&lt;b&gt;9  Check the answer&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;check_answer() · finrag/security/guardrails.py&lt;br/&gt;canary leak, invalid citations, unverified figures, output PII redaction&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1040" y="1010" width="620" height="66" as="geometry"/></mxCell>
<mxCell id="q10" value="&lt;b&gt;10  Assess confidence&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;_assess() · finrag/pipeline.py&lt;br/&gt;score from retrieval + checks; flags answers for human review (EU AI Act Art. 14)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1040" y="1100" width="620" height="66" as="geometry"/></mxCell>
<mxCell id="q11" value="&lt;b&gt;11  Label and (DPO only) re-identify&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;label_output() · finrag/governance/transparency.py: AI disclosure + not-advice notice&lt;br/&gt;Pseudonymiser.reidentify() only with Permission.REIDENTIFY, audited&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1040" y="1190" width="620" height="66" as="geometry"/></mxCell>
<mxCell id="q12" value="&lt;b&gt;12  Audit&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;AuditLog.record('query') · finrag/security/audit.py&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1040" y="1280" width="620" height="66" as="geometry"/></mxCell>
<mxCell id="q13" value="&lt;b&gt;13  Respond&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Answer(text, citations [S#], confidence, requires_review, label)&lt;br/&gt;UI shows the answer, clickable sources and a 'check this answer' banner&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1040" y="1370" width="620" height="66" as="geometry"/></mxCell>
<mxCell id="refuse" value="&lt;b&gt;Safe refusal / no answer&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;blocked question, no context, canary leak&lt;br/&gt;returns a labelled message and an audit entry&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1760" y="560" width="300" height="90" as="geometry"/></mxCell>
<mxCell id="claude" value="&lt;b&gt;Claude API&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;external, optional&lt;br/&gt;only masked excerpts are sent&lt;br/&gt;FINRAG_LLM_PROVIDER=anthropic&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1760" y="910" width="300" height="90" as="geometry"/></mxCell>
<mxCell id="rbac" value="&lt;b&gt;Roles and tenants&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;analyst · viewer · dpo · admin&lt;br/&gt;Validate tenant id, isolate stores&lt;br/&gt;finrag/security/access.py&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1760" y="290" width="300" height="100" as="geometry"/></mxCell>
<mxCell id="lg_t" value="&lt;b&gt;Legend&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1700" y="100" width="520" height="30" as="geometry"/></mxCell>
<mxCell id="lg0" value="&lt;b&gt;Pipeline step&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1700" y="135" width="250" height="26" as="geometry"/></mxCell>
<mxCell id="lg1" value="&lt;b&gt;Security / compliance control&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1970" y="135" width="250" height="26" as="geometry"/></mxCell>
<mxCell id="lg2" value="&lt;b&gt;Query step&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1700" y="167" width="250" height="26" as="geometry"/></mxCell>
<mxCell id="lg3" value="&lt;b&gt;Encrypted store&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1970" y="167" width="250" height="26" as="geometry"/></mxCell>
<mxCell id="lg4" value="&lt;b&gt;Block or refusal (red dashed arrow)&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1700" y="199" width="250" height="26" as="geometry"/></mxCell>
<mxCell id="lg5" value="&lt;b&gt;External service (optional)&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1970" y="199" width="250" height="26" as="geometry"/></mxCell>
<mxCell id="cross" value="&lt;b&gt;Cross-cutting controls&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Every control is tagged [RULE: ID] in code and listed in docs/COMPLIANCE_MATRIX.md  ·  keys: KeyRing (HKDF) from FINRAG_MASTER_KEY  ·  retention: purge_expired()  ·  data-subject rights: export_subject(), erase_subject()  ·  settings: finrag/config.py  ·  demo mode: offline only, per-visitor workspace&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="1470" width="2180" height="80" as="geometry"/></mxCell>
